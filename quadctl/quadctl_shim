#!/usr/bin/env bash
# Shim: Quadctl Entry Point (Minimal Boot)
# Author: SAC-CP (v2.1)

# Strategy: Find loader.bash
_SHIM_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# 1. Dev Mode (Relative to shim in repo)
if [[ -f "${_SHIM_DIR}/src/core/loader.bash" ]]; then
    source "${_SHIM_DIR}/src/core/loader.bash"
# 2. Installed Mode (Standard Path)
elif [[ -f "${HOME}/.local/share/quadctl/src/core/loader.bash" ]]; then
    source "${HOME}/.local/share/quadctl/src/core/loader.bash"
# 3. Fallback (Legacy/Flattened)
elif [[ -f "${HOME}/.local/share/quadctl/core/loader.bash" ]]; then
    source "${HOME}/.local/share/quadctl/core/loader.bash"
else
    echo "!! [FATAL] Quadctl Shim: Cannot find bootloader."
    echo "   Searched: ${_SHIM_DIR}/src/core/loader.bash"
    echo "   Searched: ${HOME}/.local/share/quadctl/src/core/loader.bash"
    exit 1
fi

# Handover to Dispatcher
interact_dispatch "$@"