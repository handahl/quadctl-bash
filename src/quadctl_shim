#!/usr/bin/env bash
##
### quadctl_shim - Entry point. Resolves install root, parses global flags, routes commands.
## ==============================================================================================
### TARGET : Aurora / ucore
### DEPS   : bash 5.0+, systemd, podman, jq
## ==============================================================================================
#
set -euo pipefail

# --- 1. RESOLVE INSTALLATION ROOT ---
# Reason: follow symlinks so the shim can be called from ~/.local/bin/quadctl
# pointing to the repo without requiring INSTALL_ROOT to be hardcoded.
_SOURCE="${BASH_SOURCE[0]}"
while [[ -h "$_SOURCE" ]]; do
    _DIR="$(cd -P "$(dirname "$_SOURCE")" >/dev/null 2>&1 && pwd)"
    _SOURCE="$(readlink "$_SOURCE")"
    [[ "$_SOURCE" != /* ]] && _SOURCE="$_DIR/$_SOURCE"
done
_SCRIPT_DIR="$(cd -P "$(dirname "$_SOURCE")" >/dev/null 2>&1 && pwd)"
unset _SOURCE _DIR

if [[ -d "${_SCRIPT_DIR}/src" ]]; then
    readonly INSTALL_ROOT="${_SCRIPT_DIR}"
elif [[ -d "${_SCRIPT_DIR}/../src" ]]; then
    _INSTALL_ROOT="$(dirname "${_SCRIPT_DIR}")"
    readonly INSTALL_ROOT="${_INSTALL_ROOT}"
    unset _INSTALL_ROOT
else
    # env.bash not loaded yet — use printf directly
    printf "[ERR]  Could not locate 'src' directory from %s\n" "${_SCRIPT_DIR}" >&2
    exit 1
fi
unset _SCRIPT_DIR

# --- 2. BOOTSTRAP ENVIRONMENT ---
if [[ -f "${INSTALL_ROOT}/src/core/env.bash" ]]; then
    source "${INSTALL_ROOT}/src/core/env.bash"
else
    printf "[ERR]  Core environment missing: %s/src/core/env.bash\n" "${INSTALL_ROOT}" >&2
    exit 1
fi

if [[ -f "${INSTALL_ROOT}/src/core/utils.bash" ]]; then
    source "${INSTALL_ROOT}/src/core/utils.bash"
fi

# --- 3. GLOBAL FLAG PARSING ---
# Reason: pre-verb flags follow the git/kubectl convention: quadctl [flags] <verb> [args].
# Flags are stripped here so the verb is always $1 after this block.
_Q_POST_MATRIX=false
_Q_FOLLOW=false

while [[ "${1:-}" == -* ]]; do
    case "$1" in
        -q|--quiet)    export Q_VERBOSITY=-1 ; shift ;;
        -v|--verbose)  export Q_VERBOSITY=1  ; shift ;;
        --debug)       export Q_VERBOSITY=2  ; shift ;;
        -m|--matrix)   _Q_POST_MATRIX=true   ; shift ;;
        -f|--follow)   _Q_FOLLOW=true        ; shift ;;
        -h|--help)
            source "${INSTALL_ROOT}/src/ui/help.bash"
            show_help; exit 0 ;;
        -V|--version)
            source "${INSTALL_ROOT}/src/ui/help.bash"
            show_version; exit 0 ;;
        --)            shift; break ;;
        -*)
            log_err "Unknown flag: $1"
            printf "       Run 'quadctl --help' for usage.\n" >&2
            exit 2 ;;
    esac
done

# --- 4. COMMAND ROUTING ---
# Default: matrix view — bare 'quadctl' shows the state of the system.
cmd="${1:-matrix}"
shift || true

# Dependency check — skip for informational commands that don't touch systemd/podman.
if [[ ! "$cmd" =~ ^(-h|--help|-V|--version|help|version|matrix|doctor)$ ]]; then
    source "${INSTALL_ROOT}/src/core/deps.bash"
    check_runtime_dependencies
fi

# --- 5. FILTER HELPER ---
_parse_filter() {
    local arg="${1:-}"
    if [[ "$arg" == --type=* ]]; then
        echo "${arg#*=}"
    elif [[ "$arg" =~ ^(-a|--all|all|a)$ ]]; then
        echo "all"
    else
        echo "standard"
    fi
}

# --- 6. DISPATCH ---
set +e  # Reason: per-command exit handling. Failures are reported, not propagated.

case "$cmd" in

    # -------------------------------------------------------------------------
    # MATRIX / STATUS
    # -------------------------------------------------------------------------
    matrix|s|qs|"")
        source "${INSTALL_ROOT}/src/logic/matrix.bash"
        _filter=$(_parse_filter "${1:-}")
        execute_matrix_view "$_filter"
        ;;

    status)
        # 'quadctl status <unit>' → systemctl status passthrough.
        # 'quadctl status' with no arg → matrix (mirrors muscle memory).
        if [[ -n "${1:-}" ]]; then
            source "${INSTALL_ROOT}/src/logic/control.bash"
            execute_control "status" "$1"
        else
            source "${INSTALL_ROOT}/src/logic/matrix.bash"
            execute_matrix_view "standard"
        fi
        ;;

    # -------------------------------------------------------------------------
    # UNIT CONTROL
    # -------------------------------------------------------------------------
    start|stop|restart|enable|disable|mask|unmask)
        source "${INSTALL_ROOT}/src/logic/control.bash"
        execute_control "$cmd" "${1:-}" "${_Q_FOLLOW}"
        ;;

    reload)
        source "${INSTALL_ROOT}/src/logic/control.bash"
        execute_control "reload" "${1:-}" "false"
        ;;

    # -------------------------------------------------------------------------
    # LOGS & DEBUG
    # -------------------------------------------------------------------------
    logs|log|l)
        source "${INSTALL_ROOT}/src/logic/logs.bash"
        execute_logs "${1:-}" "${2:-50}" "follow"
        ;;

    debug)
        source "${INSTALL_ROOT}/src/logic/debug.bash"
        execute_debug "${1:-}"
        ;;

    # -------------------------------------------------------------------------
    # DEPENDENCY QUERIES
    # -------------------------------------------------------------------------
    depends-on|depended-by)
        source "${INSTALL_ROOT}/src/logic/control.bash"
        execute_control "$cmd" "${1:-}" "false"
        ;;

    # -------------------------------------------------------------------------
    # INSPECTION
    # -------------------------------------------------------------------------
    cat)
        source "${INSTALL_ROOT}/src/logic/interact.bash"
        execute_cat "${1:-missing}" "${2:-}"
        ;;

    edit)
        source "${INSTALL_ROOT}/src/logic/interact.bash"
        execute_edit "${1:-missing}" "${2:-}"
        ;;

    tree)
        source "${INSTALL_ROOT}/src/logic/tree.bash"
        execute_tree_view
        ;;

    # -------------------------------------------------------------------------
    # GOVERNANCE
    # -------------------------------------------------------------------------
    audit)
        source "${INSTALL_ROOT}/src/logic/audit.bash"
        execute_audit
        ;;

    deploy|sync)
        source "${INSTALL_ROOT}/src/logic/deploy.bash"
        execute_deploy "${1:-dry-run}"
        ;;

    dry-run|dry)
        source "${INSTALL_ROOT}/src/logic/deploy.bash"
        execute_deploy "dry-run"
        ;;

    # -------------------------------------------------------------------------
    # DAEMON RELOAD
    # -------------------------------------------------------------------------
    dr|daemon-reload|rd|reload-daemon)
        source "${INSTALL_ROOT}/src/core/systemd.bash"
        _start_ts=$(date +%s%N)
        log_info "reloading systemd user daemon..."
        log_verbose "systemctl --user daemon-reload"

        if systemctl --user daemon-reload; then
            _end_ts=$(date +%s%N)
            _dur=$(( (_end_ts - _start_ts) / 1000000 ))
            log_success "daemon reloaded in ${_dur}ms."

            # Post-reload validation: stale generator output means Quadlet rejected
            # a file or deploy ran without this reload. Shared scan with deploy stage 4.
            if api_systemd_check_generator_freshness; then
                log_debug "generator output is consistent."
            fi
        else
            log_err "daemon-reload failed."
            exit 1
        fi
        ;;

    # -------------------------------------------------------------------------
    # DIAGNOSTICS
    # -------------------------------------------------------------------------
    doctor)
        source "${INSTALL_ROOT}/src/logic/doctor.bash"
        execute_doctor
        ;;

    # -------------------------------------------------------------------------
    # HELP & VERSION
    # -------------------------------------------------------------------------
    help|-h|--help)
        source "${INSTALL_ROOT}/src/ui/help.bash"
        show_help
        ;;

    version|-V|--version)
        source "${INSTALL_ROOT}/src/ui/help.bash"
        show_version
        ;;

    # -------------------------------------------------------------------------
    # UNKNOWN
    # -------------------------------------------------------------------------
    *)
        log_err "Unknown command: ${cmd}"
        printf "       Run 'quadctl --help' for usage.\n" >&2
        exit 1
        ;;
esac

# --- 7. POST-COMMAND MATRIX ---
# Reason: -m/--matrix flag shows system state after any mutating command,
# replacing the REPL's contextual matrix refresh without requiring interactivity.
if [[ "$_Q_POST_MATRIX" == true ]]; then
    source "${INSTALL_ROOT}/src/logic/matrix.bash"
    execute_matrix_view "standard"
fi
